# Copiá este archivo como ".env" (sin el ".example") y completá con tus datos reales.
# El archivo .env NUNCA debe compartirse ni subirse a un repositorio público.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=control_accesos
PORT=3000

# JWT_SECRET: una frase larga y aleatoria, usada para firmar las sesiones de login.
# Cambiala por cualquier texto propio, cuanto más largo y random, mejor.
JWT_SECRET=cambiar-esto-por-un-texto-largo-y-aleatorio-propio

# Configuración de correo, para enviar los mails de "olvidé mi usuario/contraseña".
# Ejemplo con Gmail: necesitás una "contraseña de aplicación" (no tu contraseña normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicación-de-16-caracteres
SMTP_FROM=Control de Acceso <tu-correo@gmail.com>
