# Variables de entorno del servidor.
# En Railway se cargan en la pestaña "Variables" del servicio de la app (no se sube este archivo).
# Para probar en tu compu, copiá este archivo como ".env" y completá los valores.

# --- Base de datos ---
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=railway

# --- Seguridad ---
# Una frase larga y al azar (30 caracteres o más). Si se cambia, todas las sesiones se cierran.
JWT_SECRET=

# --- Zona horaria del negocio (hora de las entradas y cálculo de "llegó tarde") ---
ZONA_HORARIA=America/Argentina/Buenos_Aires

# --- Panel para vos, que vendés la app (opcional) ---
# Una clave larga (12 caracteres o más). Con ella entrás a /plataforma.html y ves las empresas registradas.
# Si la dejás vacía, el panel no existe.
PLATAFORMA_CLAVE=

# --- Alta de empresas ---
# "true" (por defecto): el cliente debe confirmar su email con un código antes de entrar.
# "false": entra directo sin confirmar (útil solo para pruebas).
VERIFICAR_EMAIL=true
# Nombre de la empresa a la que se pasan los datos que ya existían (solo se usa una vez, al actualizar).
EMPRESA_INICIAL=Mi empresa

# --- Envío de mails: elegí UNA de las tres opciones ---
# Mail "desde" y nombre que ve quien lo recibe (para Resend y Brevo):
MAIL_REMITENTE=
MAIL_NOMBRE=Control de acceso

# Opción 1 (recomendada, con dominio propio): Resend
RESEND_API_KEY=

# Opción 2: Brevo (por API)
BREVO_API_KEY=

# Opción 3: SMTP clásico (Railway suele bloquearlo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
